{
  "name": "@tien-gioi/client",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/stamp-sw.mjs",
    "build:packs": "node scripts/build-packs.mjs",
    "check:packs": "node scripts/build-packs.mjs --check",
    "check:budget": "node scripts/check-perf-budget.mjs",
    "build:native": "vite build --mode native",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:credits": "node scripts/check-credits.mjs",
    "perf:mobile": "node scripts/measure-mobile-perf.mjs",
    "perf:4g": "node scripts/measure-4g.mjs",
    "preview": "vite preview --host",
    "assets": "node scripts/gen-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@tien-gioi/shared": "*",
    "colyseus.js": "0.16.22",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "6.4.5"
  }
}
