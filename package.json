{
  "name": "tien-gioi",
  "private": true,
  "version": "0.1.3",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "build:native": "npm run build:native -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w server --",
    "e2e:tai-khoan": "npm run e2e:tai-khoan -w server --",
    "e2e:bi-canh": "npm run e2e:bi-canh -w server --",
    "e2e:pk": "npm run e2e:pk -w server --",
    "e2e:phien-ban": "npm run e2e:phien-ban -w server --",
    "e2e:tro-nang": "npm run e2e:tro-nang -w server --",
    "e2e:ban-phim": "npm run e2e:ban-phim -w server --",
    "e2e:noi-lai": "npm run e2e:noi-lai -w server --",
    "e2e:nhip-tim": "npm run e2e:nhip-tim -w server --",
    "tai-khoan": "npm run tai-khoan -w server --",
    "chuyen-du-lieu": "npm run chuyen-du-lieu -w server --",
    "check:env": "npm run check:env -w server",
    "khoi-phuc-thu": "npm run khoi-phuc-thu -w server",
    "soak": "npm run soak -w server --",
    "check:pwa": "node client/scripts/check-pwa.mjs",
    "check:credits": "node client/scripts/check-credits.mjs",
    "perf:mobile": "node client/scripts/measure-mobile-perf.mjs",
    "capture:viewports": "node client/scripts/capture-viewports.mjs",
    "chup-viewport": "node client/scripts/capture-viewports.mjs",
    "check:budget": "node client/scripts/check-perf-budget.mjs",
    "leak:test": "node client/scripts/leak-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "9.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
